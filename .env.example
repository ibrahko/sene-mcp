# Copy this file to .env and fill in the values. Never commit .env.

# Needed only for analyze_photo (lot 2) and the evaluation (lot 3).
ANTHROPIC_API_KEY=

# Optional. By default the database is sene.db in a per-user folder
# (Windows: %LOCALAPPDATA%\sene-mcp). Set SENE_DATA_DIR to change the folder,
# or SENE_DATABASE_URL to use another database.
# SENE_DATA_DIR=
# SENE_DATABASE_URL=
